diff --git a/go_client/dispatcher.go b/go_client/dispatcher.go
--- a/go_client/dispatcher.go
+++ b/go_client/dispatcher.go
@@ -379,14 +379,15 @@
-			// Все workers перегружены — сдвигаем указатель, пакет дропается
-			d.rrIndex = (idx + 1) % nw
-			d.rrCount = 0
-			putPktBuf(pkt)
