# Исходники храним и выдаём с LF: internal/core должен побайтово совпадать
# с апстримом qWDTT, иначе дифф при обновлении ядра забивается концами строк.
* text=auto eol=lf

*.go       text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
.gitignore text eol=lf

# Эталон tar для теста scripts/release — сравнивается побайтово.
*.tar      binary

LICENSE text eol=lf
